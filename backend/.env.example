# Microservice URLs (defaults already match docker-compose / local dev)
FLIGHT_AGENT_URL=http://localhost:8001
HOTEL_AGENT_URL=http://localhost:8002

# PackageSelectionAgent LLM provider (see backend/agents/llm_client.py)
# Supported: gemini (default, free tier), anthropic, openai
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Only needed if you set LLM_PROVIDER to one of these instead
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
